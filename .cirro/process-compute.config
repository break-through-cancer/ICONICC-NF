process {
    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 2

    withName: 'PARABRICKS_HAPLOTYPECALLER' {
        accelerator   = 1
        queue         = env('PW_ONDEMAND_JOB_QUEUE')
        // 255 added after a real OOM: pbrun's own wrapper catches the inner htvc binary's
        // 137 (SIGKILL) and re-exits the container with its own generic failure code, 255,
        // instead of letting 137 itself propagate to Nextflow -- confirmed via a live
        // run's .exitcode file (255) alongside the AWS-level "OutOfMemoryError: Container
        // killed due to memory usage" message. Neither matches 130..145/104/175..177/
        // 2147483647, so the task failed outright without ever retrying at a higher
        // memory. Scoped to this process only -- 255 is generic enough elsewhere that
        // retrying on it globally risks masking real (non-memory) failures.
        errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177) + 255 + 2147483647) ? 'retry' : 'finish' }
        maxRetries    = 2
    }
}
