process {
    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 2

    withName: 'PARABRICKS_HAPLOTYPECALLER' {
        accelerator   = 1
        queue         = env('PW_ONDEMAND_JOB_QUEUE')
        errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177) + 2147483647) ? 'retry' : 'finish' }
        maxRetries    = 2
    }
}
