nextflow.enable.dsl = 2

// Nextflow's AWS Batch executor defaults to queueSize=1000 with no submission
// throttling, firing a burst of SubmitJob calls every time a pipeline stage completes.
// Scatter-gather (SAMPLE_READ_COUNTS, CNV_CORE) multiplies job count per sample by
// however many shards are configured, and PW_ONDEMAND_JOB_QUEUE is shared across every
// pipeline in this Cirro project, not exclusive to this one -- bound both the
// concurrently-submitted job count and the submission rate explicitly rather than
// relying on that default, to avoid AWS Batch API throttling and queue contention at
// cohort scale.
executor {
    queueSize = 100
    submitRateLimit = '20/1min'
}

params.outdir = './results'
params.cnv_r_container = 'ghcr.io/break-through-cancer/iconicc-cnv-r:latest'
// Base memory for PARABRICKS_HAPLOTYPECALLER, scaled by task.attempt on each OOM retry
// (see the withName: block below) -- null means use that block's own 72 GB default.
// Matches parabricks_bqsr's own fq2bam_memory_gb override pattern.
params.haplotypecaller_memory_gb = null

params.ref_fasta      = 's3://broad-references/hg38/v0/Homo_sapiens_assembly38.fasta'
params.ref_fasta_fai  = 's3://broad-references/hg38/v0/Homo_sapiens_assembly38.fasta.fai'
params.ref_fasta_dict = 's3://broad-references/hg38/v0/Homo_sapiens_assembly38.dict'

params.ref_dir_1000g = 's3://btc-refdata/iconicc/reference-genome-1000G.tar'
params.genetic_map = 's3://btc-refdata/iconicc/reference-genome-genetic_map_hg38_withX.txt.gz'

// The chromosome list this pipeline's CNV phasing panel (ref_dir_1000g) is built
// around, and what 'per_chromosome' scatter modes shard over (SAMPLE_READ_COUNTS,
// CNV_CORE). hg38 default: chr1-22 + X, matching the panel's own per-chromosome files.
// Override for other species/reference builds (e.g. canine: (1..38).collect {
// it.toString() } + ['X']) -- see iconicc-nf-canine-expansion.md.
params.scatter_chromosomes = (1..22).collect { it.toString() } + ['X']

// SAMPLE_READ_COUNTS scatter-gather (real-world finding, 2026-10-20: a single whole-
// genome COLLECT_READ_COUNTS call took tens of hours on real high-coverage data).
// 'groups': split into read_counts_scatter_count size-balanced shards via GATK's own
// SplitIntervals (handles alt/decoy contigs sensibly with no special-casing) -- the
// default, bounds job count for cohort-scale runs. 'per_chromosome': one shard per
// params.scatter_chromosomes entry -- maximum parallelism for a single-sample run,
// where job count at scale isn't the concern.
params.read_counts_scatter_mode  = 'groups'
params.read_counts_scatter_count = 8

// CNV_CORE's ITER_ISEC/EAGLE_PHASING scatter (SPEC.md Sec14.1); HETVAR_FILTER/INDEX_PHASED stay single-task.
params.cnv_scatter_mode  = 'groups'
params.cnv_scatter_count = 4

params.pon             = 's3://btc-refdata/iconicc/BTC_pon.rds'
params.ref_clinical     = 's3://btc-refdata/iconicc/reference_clinical.txt'
params.cohort_clinical  = 's3://btc-refdata/iconicc/btc_clinical.txt'

// Phase 2 (SPEC.md §12): calling + joint-genotyping reference inputs.
params.calling_intervals = 's3://gatk-test-data/intervals/hg38.even.handcurated.20k.intervals'

params.dbsnp_vcf              = 's3://broad-references/hg38/v0/Homo_sapiens_assembly38.dbsnp138.vcf'
params.dbsnp_vcf_index        = 's3://broad-references/hg38/v0/Homo_sapiens_assembly38.dbsnp138.vcf.idx'
params.hapmap_resource_vcf       = 's3://broad-references/hg38/v0/hapmap_3.3.hg38.vcf.gz'
params.hapmap_resource_vcf_index = 's3://broad-references/hg38/v0/hapmap_3.3.hg38.vcf.gz.tbi'
params.omni_resource_vcf         = 's3://broad-references/hg38/v0/1000G_omni2.5.hg38.vcf.gz'
params.omni_resource_vcf_index   = 's3://broad-references/hg38/v0/1000G_omni2.5.hg38.vcf.gz.tbi'
params.one_thousand_genomes_resource_vcf       = 's3://broad-references/hg38/v0/1000G_phase1.snps.high_confidence.hg38.vcf.gz'
params.one_thousand_genomes_resource_vcf_index = 's3://broad-references/hg38/v0/1000G_phase1.snps.high_confidence.hg38.vcf.gz.tbi'
params.mills_resource_vcf        = 's3://broad-references/hg38/v0/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz'
params.mills_resource_vcf_index  = 's3://broad-references/hg38/v0/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz.tbi'
params.axiomPoly_resource_vcf       = 's3://broad-references/hg38/v0/Axiom_Exome_Plus.genotypes.all_populations.poly.hg38.vcf.gz'
params.axiomPoly_resource_vcf_index = 's3://broad-references/hg38/v0/Axiom_Exome_Plus.genotypes.all_populations.poly.hg38.vcf.gz.tbi'

// Samplesheet path -- see SPEC.md §11.2 for the column schema and assets/samplesheet.csv
// for a template. No sensible default exists; must be supplied via --input.
params.input = null

// Real sample identifiers for the CNV_CORE subworkflow-level nf-test
// (tests/subworkflows/cnv_core.nf.test), per Task 14 Step 7's note: this
// test needs the real staged run's identifiers, not synthetic TEST_*
// placeholders. Reading tests/fixtures/cnv_core/sample_info.env dynamically
// from this file was tried and rejected -- Nextflow 26's strict config
// parser rejects `if`/`def` statements mixed with declarative config
// statements ("If statements cannot be mixed with config statements").
// Left null until fixtures are staged (Task 3 Step 2): once
// tests/fixtures/cnv_core/sample_info.env exists, replace these four
// literals with its PARTICIPANT_ID / NORMAL_SAMPLE_ID / TUMOR_SAMPLE_ID /
// SAMPLE_SEX values by hand (or override on the CLI with
// `-params-file`/`--fixture_*` when invoking nf-test).
params.fixture_participant_id = null
params.fixture_normal_id      = null
params.fixture_tumor_id       = null
params.fixture_sample_sex     = null

process {
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: 'copy',
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    // Only the five final CNV_CORE outputs (SPEC.md section 6: read_depth,
    // seg_file, ac_cts, segment_plots, segment_cts) are worth keeping, and
    // those come from AC_CALC, TANGENT_XY and SEGMENT -- which inherit the
    // default publishDir above. Every other process emits WGS-scale
    // intermediates (per-chromosome VCFs, 23 files apiece at several stages,
    // plus CRAM-derived counts and interval lists); copying those into
    // results/ would move hundreds of GB per run for no downstream use, so
    // publishing is disabled for each of them explicitly.
    // COLLECT_READ_COUNTS is called unaliased from
    // subworkflows/local/sample_read_counts/main.nf, once per unique sample
    // (not per pair), so a single withName selector on its own process name
    // covers every invocation.
    // Published as "haplotypecaller/", not the default "index_gvcf/" -- INDEX_GVCF is
    // just the implementation detail that staples the .tbi on; the content is the
    // germline GVCF calls.
    withName: 'INDEX_GVCF' {
        publishDir = [
            path: { "${params.outdir}/haplotypecaller" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'SUBSET_PAIR_VCF'             { publishDir = [ enabled: false ] }
    withName: 'PREPROCESS_INTERVALS'        { publishDir = [ enabled: false ] }
    withName: 'SPLIT_INTERVALS'             { publishDir = [ enabled: false ] }
    withName: 'COLLECT_READ_COUNTS'         { publishDir = [ enabled: false ] }
    withName: 'FILTER_VARIANTS'             { publishDir = [ enabled: false ] }
    withName: 'ITER_ISEC'                   { publishDir = [ enabled: false ] }
    withName: 'HETVAR_FILTER'               { publishDir = [ enabled: false ] }
    withName: 'EAGLE_PHASING'               { publishDir = [ enabled: false ] }
    withName: 'INDEX_PHASED'                { publishDir = [ enabled: false ] }
    withName: 'QUERY_HET_AD'                { publishDir = [ enabled: false ] }
    // Remaining WGS-scale JOINT_GENOTYPING intermediates -- same rationale as above.
    withName: 'VARIANT_FILTRATION'          { publishDir = [ enabled: false ] }
    withName: 'MAKE_SITES_ONLY_VCF'         { publishDir = [ enabled: false ] }
    // GATK4_GENOMICSDBIMPORT through APPLYVQSR_SNP below are the JOINT_GENOTYPING chain
    // (Task 5, subworkflows/local/joint_genotyping/main.nf). Every step here emits a
    // WGS-scale intermediate (a full GenomicsDB workspace, per-pair VCFs, recal/tranches
    // files) that is never one of SPEC.md section 6's five final outputs -- even the
    // final ApplyVQSR VCF was samplesheet-supplied pre-Phase-2 and was never a published
    // pipeline output -- so publishDir is disabled for all six, matching the pattern
    // above for the other WGS-scale-intermediate processes.
    // Resource sizing below (cpus/memory on GATK4_GENOMICSDBIMPORT, GATK4_GENOTYPEGVCFS,
    // VARIANTRECALIBRATOR_SNP/_INDEL, APPLYVQSR_SNP/_INDEL, PARABRICKS_HAPLOTYPECALLER)
    // follows this repo's own convention of cpus/memory values declared directly
    // (see e.g. modules/local/preprocess_intervals.nf, modules/local/collect_read_counts.nf)
    // rather than a withLabel: label system -- this repo defines no withLabel: selectors
    // or base.config, so the vendored modules' process_single/process_low/process_high/
    // process_gpu labels would otherwise fall back to weak nf-core defaults (a 3GB GATK
    // heap with a warning, 1 CPU everywhere). Base values translated from sarek's own
    // conf/base.config label definitions: process_single -> cpus 1 / memory 6 GB,
    // process_low -> cpus 2 / memory 12 GB, process_high -> cpus 12 / memory 72 GB.
    //
    // Memory on all seven is `base * task.attempt`, not a flat value: a real (non-toy)
    // tumor/normal pair OOM-killed PARABRICKS_HAPLOTYPECALLER at a fixed 72 GB (exit 137,
    // confirmed against a live Cirro run), and .cirro/process-compute.config already
    // retries on exactly that exit code -- but a flat memory value means every retry
    // fails identically. Matches parabricks_bqsr's own `memory { base * task.attempt }`
    // pattern (tests/config/test_oom_retry.py there) rather than inventing a new one.
    withName: 'GATK4_GENOMICSDBIMPORT' {
        container   = 'broadinstitute/gatk@sha256:21c3cb43b7d11891ed4b63cc7274f20187f00387cfaa0433b3e7991b5be34dbe'
        // --merge-input-intervals: sarek only omits this for its WGS branch, which is
        // scattered one-interval-per-call. This plan has no interval scatter (SPEC.md
        // Sec12.6) -- every call gets the full calling_intervals list in one shot, the
        // same situation sarek's own WES branch is in, which DOES pass this flag. The
        // source WDL's ImportGVCFs/GenotypeGVCFs tasks also pass it.
        ext.args    = '--genomicsdb-shared-posixfs-optimizations true --bypass-feature-reader --merge-input-intervals'
        cpus        = 1
        memory      = { "${6 * task.attempt} GB" }
        publishDir  = [ enabled: false ]
    }
    withName: 'GATK4_GENOTYPEGVCFS' {
        container   = 'broadinstitute/gatk@sha256:21c3cb43b7d11891ed4b63cc7274f20187f00387cfaa0433b3e7991b5be34dbe'
        ext.args    = '--merge-input-intervals'
        cpus        = 1
        memory      = { "${6 * task.attempt} GB" }
        publishDir  = [ enabled: false ]
    }
    withName: 'VARIANTRECALIBRATOR_SNP' {
        container   = 'broadinstitute/gatk@sha256:21c3cb43b7d11891ed4b63cc7274f20187f00387cfaa0433b3e7991b5be34dbe'
        ext.args    = '-tranche 100.0 -tranche 99.95 -tranche 99.9 -tranche 99.8 -tranche 99.6 -tranche 99.5 -tranche 99.4 -tranche 99.3 -tranche 99.0 -tranche 98.0 -tranche 97.0 -tranche 90.0 -an QD -an MQRankSum -an ReadPosRankSum -an FS -an MQ -an SOR -an DP -mode SNP --max-gaussians 6 --trust-all-polymorphic'
        cpus        = 2
        memory      = { "${12 * task.attempt} GB" }
        publishDir  = [ enabled: false ]
    }
    withName: 'VARIANTRECALIBRATOR_INDEL' {
        container   = 'broadinstitute/gatk@sha256:21c3cb43b7d11891ed4b63cc7274f20187f00387cfaa0433b3e7991b5be34dbe'
        ext.args    = '-tranche 100.0 -tranche 99.95 -tranche 99.9 -tranche 99.5 -tranche 99.0 -tranche 97.0 -tranche 96.0 -tranche 95.0 -tranche 94.0 -tranche 93.5 -tranche 93.0 -tranche 92.0 -tranche 91.0 -tranche 90.0 -an FS -an ReadPosRankSum -an MQRankSum -an QD -an SOR -an DP -mode INDEL --max-gaussians 4 --trust-all-polymorphic'
        cpus        = 2
        memory      = { "${12 * task.attempt} GB" }
        publishDir  = [ enabled: false ]
    }
    withName: 'APPLYVQSR_INDEL' {
        container   = 'broadinstitute/gatk@sha256:21c3cb43b7d11891ed4b63cc7274f20187f00387cfaa0433b3e7991b5be34dbe'
        ext.args    = '--truth-sensitivity-filter-level 99.0 -mode INDEL'
        // Distinct from APPLYVQSR_SNP's prefix below -- APPLYVQSR_SNP consumes this
        // process's VCF output as its own --variant input, so without distinct prefixes
        // both processes would default to "${meta.id}.vcf.gz" and APPLYVQSR_SNP would
        // read and write the same filename (GATK4_APPLYVQSR's default prefix is
        // task.ext.prefix ?: "${meta.id}").
        ext.prefix  = { "${meta.id}.indel_recalibrated" }
        cpus        = 2
        memory      = { "${12 * task.attempt} GB" }
        publishDir  = [ enabled: false ]
    }
    withName: 'APPLYVQSR_SNP' {
        container   = 'broadinstitute/gatk@sha256:21c3cb43b7d11891ed4b63cc7274f20187f00387cfaa0433b3e7991b5be34dbe'
        ext.args    = '--truth-sensitivity-filter-level 99.7 -mode SNP'
        ext.prefix  = { "${meta.id}.recalibrated" }
        cpus        = 2
        memory      = { "${12 * task.attempt} GB" }
        publishDir  = [ enabled: false ]
    }
    // Bare module names (used directly by their own standalone module-level tests in
    // tests/nf-core/gatk4/) -- container pin only, not the aliases' SNP/INDEL-specific
    // ext.args, which are deliberately restricted to the VARIANTRECALIBRATOR_SNP/_INDEL
    // and APPLYVQSR_SNP/_INDEL aliases above.
    withName: 'GATK4_VARIANTRECALIBRATOR' {
        container = 'broadinstitute/gatk@sha256:21c3cb43b7d11891ed4b63cc7274f20187f00387cfaa0433b3e7991b5be34dbe'
    }
    withName: 'GATK4_APPLYVQSR' {
        container = 'broadinstitute/gatk@sha256:21c3cb43b7d11891ed4b63cc7274f20187f00387cfaa0433b3e7991b5be34dbe'
    }
    // cpus/memory below reflect the real production GPU-node sizing this pipeline expects
    // Cirro to provision (process_high: SPEC.md Sec12.7). GPU accelerator scheduling itself
    // is deliberately left to Cirro's external process-compute.config layer (SPEC.md Sec2,
    // citing Cirro-pipelines commit 7da9376 -- Cirro forces GPU requests unconditionally at
    // that layer because it can't pass -profile gpu conditionally per run). That's Phase
    // 3's job; do not add a task.accelerator directive here. (Tests that run this process
    // under -stub on a dev machine override cpus/memory down to something a local executor
    // can actually admit -- see tests/nf-core/parabricks/haplotypecaller.nf.config -- rather
    // than inflating the executor's admission ceiling here for every real run.)
    withName: 'PARABRICKS_HAPLOTYPECALLER' {
        // --gvcf, -GQB and -G reproduce ICONICC's own HaplotypeCaller tuning (SPEC.md
        // Sec5.2, verified against NVIDIA's full Parabricks option reference): GVCF mode,
        // the same GQ confidence-band boundaries, and the same three annotation groups.
        // Parabricks' own tool defaults would silently diverge from these otherwise.
        ext.args   = '--gvcf -GQB 10 -GQB 20 -GQB 30 -GQB 40 -GQB 50 -GQB 60 -GQB 70 -GQB 80 -GQB 90 -G StandardAnnotation -G StandardHCAnnotation -G AS_StandardAnnotation'
        cpus       = 12
        memory     = { "${(params.haplotypecaller_memory_gb ?: 72) * task.attempt} GB" }
        // Published from INDEX_GVCF instead (bundled with its .tbi there, no duplicate copy).
        publishDir = [ enabled: false ]
    }
}

docker {
    enabled = true
}
