# External reference material pulled for porting - not part of this repo
/reference/

# Nextflow runtime
.nextflow*
work/
results/
.nf-test*
# Personal-machine nf-test override (e.g. local reference paths) -- never shared/committed
nf-test.config
tests/local.nextflow.config
tests/fixtures/*
!tests/fixtures/cnv_core/
tests/fixtures/cnv_core/*
!tests/fixtures/cnv_core/README.md
# samplesheet_to_pairs fixtures ARE committed (tiny placeholders, not real genomic data)
!tests/fixtures/samplesheet_to_pairs/
# joint_genotyping fixtures ARE committed (tiny placeholders, not real genomic data)
!tests/fixtures/joint_genotyping/
# main_pipeline fixtures ARE committed (tiny placeholders, not real genomic data) --
# used by the top-level tests/main.nf.test to override the real S3 reference defaults
!tests/fixtures/main_pipeline/
# split_intervals fixtures ARE committed (synthetic interval rows against the real hg38
# dictionary's own @SQ lines, no genomic data)
!tests/fixtures/split_intervals/
# gather_read_counts fixtures ARE committed (hand-built, format-accurate TSV rows, no
# genomic data)
!tests/fixtures/gather_read_counts/
# gather_genotyped_vcf fixtures ARE committed (hand-built, bgzipped/tabix-indexed VCF
# shards with synthetic records, no genomic data)
!tests/fixtures/gather_genotyped_vcf/
# hetvar_filter fixtures ARE committed (hand-built, synthetic VCF, no genomic data)
!tests/fixtures/hetvar_filter/

# Claude Code harness metadata -- worktrees, SDD ledgers/briefs/reports, scheduled-task
# locks. Never part of this repo's own history, regardless of what ends up inside it.
.claude/

# Python (.cirro/preprocess.py)
__pycache__/
*.pyc

# R
.Rproj.user/
*.Rhistory

# macOS
.DS_Store
