// tests/nf-core/gatk4/variantrecalibrator.nf.test
nextflow_process {
    name "Test GATK4_VARIANTRECALIBRATOR"
    script "modules/nf-core/gatk4/variantrecalibrator/main.nf"
    process "GATK4_VARIANTRECALIBRATOR"

    test("fits a recalibration model against SNP-shaped resources") {
        when {
            process {
                """
                input[0] = [
                    [ id: 'TEST_PAIR' ],
                    file("\${projectDir}/tests/fixtures/joint_genotyping/placeholder.g.vcf.gz"),
                    file("\${projectDir}/tests/fixtures/joint_genotyping/placeholder.g.vcf.gz.tbi")
                ]
                input[1] = [
                    file("\${projectDir}/tests/fixtures/joint_genotyping/resource1.vcf.gz"),
                    file("\${projectDir}/tests/fixtures/joint_genotyping/resource2.vcf.gz"),
                    file("\${projectDir}/tests/fixtures/joint_genotyping/resource3.vcf.gz"),
                    file("\${projectDir}/tests/fixtures/joint_genotyping/resource4.vcf.gz")
                ]
                input[2] = [
                    file("\${projectDir}/tests/fixtures/joint_genotyping/resource1.vcf.gz.tbi"),
                    file("\${projectDir}/tests/fixtures/joint_genotyping/resource2.vcf.gz.tbi"),
                    file("\${projectDir}/tests/fixtures/joint_genotyping/resource3.vcf.gz.tbi"),
                    file("\${projectDir}/tests/fixtures/joint_genotyping/resource4.vcf.gz.tbi")
                ]
                input[3] = [
                    '--resource:hapmap,known=false,training=true,truth=true,prior=15.0 ref_fasta',
                    '--resource:omni,known=false,training=true,truth=true,prior=12.0 ref_fasta',
                    '--resource:1000G,known=false,training=true,truth=false,prior=10.0 ref_fasta',
                    '--resource:dbsnp,known=true,training=false,truth=false,prior=7.0 ref_fasta'
                ]
                input[4] = file("\${projectDir}/tests/fixtures/joint_genotyping/reference.fasta")
                input[5] = file("\${projectDir}/tests/fixtures/joint_genotyping/reference.fasta.fai")
                input[6] = file("\${projectDir}/tests/fixtures/joint_genotyping/reference.dict")
                """
            }
        }
        then {
            // Known, accepted gap: This test runs the base GATK4_VARIANTRECALIBRATOR process
            // without the SNP-mode -an (use-annotation) arguments, which Task 5's
            // VARIANTRECALIBRATOR_SNP alias will provide via withName selector. Running
            // the base process without required -an arguments causes GATK to fail with
            // "Argument use-annotation was missing" before any placeholder-data issues
            // surface. This is expected and correct wiring. Do not flip to !process.success.
            assert process.success
        }
    }
}
