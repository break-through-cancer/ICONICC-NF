process {
    withName: 'PARABRICKS_HAPLOTYPECALLER' {
        ext.args = '--gvcf'
        // Test-scoped only: nextflow.config's real cpus=12/memory='72 GB' (production
        // GPU-node sizing) exceeds what a dev machine's local executor can actually admit
        // for a stub run. This config is merged on top of nextflow.config via nf-test's
        // own `config` mechanism (not a replacement), so it overrides just the sizing for
        // every test that references this file, without inflating the shared executor's
        // admission ceiling for real `nextflow run` invocations.
        cpus = 1
        memory = '2 GB'
    }
}
